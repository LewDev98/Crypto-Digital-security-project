{
  "manifest_version": 3,
  "name": "Bodyguard Shield",
  "version": "1.2.1",
  "description": "Your Bodyguard agent in the browser: blocks drainer transactions and poisoned addresses before your wallet signs.",
  "action": { "default_popup": "popup.html", "default_title": "Bodyguard Shield", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://guardagent.tech/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["inject.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }
  ]
}
